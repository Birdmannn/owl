{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@owl/pilot": [
        "../../src/index.ts"
      ],
      "@owl/pilot-react": [
        "../../packages/react/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "tests"
  ]
}
