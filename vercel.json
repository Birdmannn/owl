{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix packages/react && npm ci --prefix apps/demo",
  "buildCommand": "npm run build --prefix apps/demo",
  "outputDirectory": "apps/demo/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?pilotRoute=:path*" }
  ]
}
