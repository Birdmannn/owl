# PostgreSQL for registry, social state, paymaster journals and shared rate limits.
# Standalone services use local JSON when unset. Vercel requires DATABASE_URL.
# DATABASE_URL=postgresql://user:password@localhost:5432/pilot
PILOT_REGISTRY_PORT=5180
PILOT_REGISTRY_NETWORK=ckb-testnet
# Set the public registry origin and allowed app origins when deploying.
# PILOT_REGISTRY_ORIGIN=https://registry.example
# PILOT_REGISTRY_ALLOWED_ORIGINS=https://app.example,https://docs.example
# PILOT_REGISTRY_FILE=data/pilot-usernames.json

# Optional shared social demo verifier. Default frontend mode is browser-local.
# PILOT_SOCIAL_PORT=5181
# PILOT_SOCIAL_HOST=127.0.0.1
# Exact frontend origin, no trailing slash or path:
# PILOT_SOCIAL_AUDIENCE=https://demo.example
# Persistent file path on the social backend host:
# PILOT_SOCIAL_FILE=/persistent/pilot-social.json
# Frontend build variable (public URL only; includes /api/social):
# VITE_PILOT_SOCIAL_URL=https://api.example/api/social

# Server only. Never put the pool private key in a VITE_ variable.
# PILOT_DEPLOYER_PRIVATE_KEY=
# PILOT_PAYMASTER_PRIVATE_KEY=
# PILOT_PAYMASTER_ADDRESS=ckt1... (defaults to deployments/owl-paymaster.json)
PILOT_PAYMASTER_PORT=5182
PILOT_PAYMASTER_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PILOT_PAYMASTER_MAX_FEE=100000
PILOT_PAYMASTER_DAILY_BUDGET=100000000
PILOT_PAYMASTER_OWNER_DAILY_BUDGET=1000000
# Enable in apps/demo/.env only after deploying sponsored contracts/configuring the pinned pool:
# VITE_PILOT_PAYMASTER_URL=http://127.0.0.1:5182/api/paymaster

# Vercel: exact HTTPS frontend origin, no path/trailing slash. See VERCEL.md.
# Defaults registry origin/allowlists and social audience to this value on Vercel.
# PILOT_APP_ORIGIN=https://pilot.example
# VITE_PILOT_PAYMASTER_URL=https://pilot.example/api/paymaster
# VITE_PILOT_SOCIAL_URL=https://pilot.example/api/social
# On Vercel omit localhost *_ALLOWED_ORIGINS above or override with HTTPS origins.
